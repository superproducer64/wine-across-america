{
  "expo": {
    "name": "Pour Across America",
    "slug": "pour-across-america",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F1518"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.pouracrossamerica",
      "buildNumber": "51",
      "appleTeamId": "4JZRW3MPP2",
      "infoPlist": {
        "NSCameraUsageDescription": "Pour Across America uses your camera to photograph wine labels.",
        "NSPhotoLibraryUsageDescription": "Pour Across America needs access to your photos to attach wine label photos.",
        "NSLocationWhenInUseUsageDescription": "Pour Across America uses your location to log where you tasted each wine.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram"
        ]
      },
      "associatedDomains": [
        "applinks:pouracrossamerica.com.bgpstudios.com"
      ],
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F1518"
      },
      "package": "com.paa.myapp",
      "versionCode": 8,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "pouracrossamerica"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "description": "A professional wine tasting journal. Log wines, scan labels with AI, score and compare bottles, and track your tastings across the country."
    },
    "plugins": [
      "./plugins/withAndroidSdk35",
      "./plugins/withInstagramQueries",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C4847A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour Across America needs access to your photos to attach wine label photos.",
          "cameraPermission": "Pour Across America uses your camera to photograph wine labels."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pour Across America uses your location to log where you tasted each wine."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      "expo-font"
    ],
    "scheme": "pouracrossamerica",
    "extra": {
      "eas": {
        "projectId": "002044a5-1a3b-4980-85de-826b557ae9a9"
      }
    },
    "owner": "superproducer64"
  }
}
